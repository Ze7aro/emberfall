; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[admob]

general/android/app_id="ca-app-pub-4856775590726819~9395850037"

[application]

config/name="Emberfall"
run/main_scene="res://scenes/MainLayout.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7")
boot_splash/bg_color=Color(0.086, 0.027, 0.188, 1)
boot_splash/image="res://assets/ui/icono/splash_1024.png"
config/icon="res://assets/ui/icono/icon_512.png"
boot_splash/minimum_display_time=600

[audio]

buses/default_bus_layout="res://resources/audio/default_bus_layout.tres"

[autoload]

GameState="*res://scripts/systems/game_state.gd"
MusicDirector="*res://scripts/systems/music_director.gd"
SfxPlayer="*res://scripts/systems/sfx_player.gd"
Monetization="*res://scripts/systems/monetization.gd"
Localization="*res://scripts/systems/localization.gd"

[display]

window/size/viewport_width=390
window/size/viewport_height=844
window/size/window_width_override=390
window/size/window_height_override=844
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/GodotGooglePlayBilling/plugin.cfg", "res://addons/admob/plugin.cfg")

[gui]

theme/default_font_multichannel_signed_distance_field=true
theme/custom_font="res://assets/ui/fuentes/texto.tres"

[internationalization]

locale/fallback="es"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
