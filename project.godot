; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Emberfall"
run/main_scene="res://scenes/MainLayout.tscn"
config/features=PackedStringArray("4.7")
config/quit_on_go_back=false

[audio]

buses/default_bus_layout="res://resources/audio/default_bus_layout.tres"

[autoload]

GameState="*res://scripts/systems/game_state.gd"
MusicDirector="*res://scripts/systems/music_director.gd"
SfxPlayer="*res://scripts/systems/sfx_player.gd"

[display]

window/size/viewport_width=390
window/size/viewport_height=844
window/size/window_width_override=390
window/size/window_height_override=844
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[gui]

theme/default_font_multichannel_signed_distance_field=true

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
